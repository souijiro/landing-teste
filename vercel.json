{
  "version": 2,
  "routes": [
    { "src": "/", "has": [{ "type": "host", "value": "black.confeitaria5estrelas.com" }], "dest": "/black2026/index.html" },
    { "src": "/obrigado/?", "has": [{ "type": "host", "value": "black.confeitaria5estrelas.com" }], "dest": "/black2026/obrigado/index.html", "headers": { "X-Robots-Tag": "noindex, nofollow" } },
    { "src": "/(?!black2026/(?:img/|styles\\.css|script\\.js)).*", "has": [{ "type": "host", "value": "black.confeitaria5estrelas.com" }], "status": 404 },
    { "src": "/(controles(?:-[a-z0-9-]+)?(?:/.*)?)", "has": [{ "type": "host", "value": "c.docis.com.br" }], "dest": "https://docis-controles.vercel.app/$1" },
    { "src": "/(deliverydeaaz(?:/.*)?)", "has": [{ "type": "host", "value": "c.docis.com.br" }], "dest": "https://docis-delivery.vercel.app/$1" },
    { "src": "/", "has": [{ "type": "host", "value": "c.canaga.com.br" }], "status": 302, "headers": { "Location": "/lancamento" } },
    { "src": "/lancamento/?", "has": [{ "type": "host", "value": "c.canaga.com.br" }], "dest": "/canaga/index.html" },
    { "src": "/dash/manifest.webmanifest", "dest": "/dash/manifest.webmanifest", "headers": { "Content-Type": "application/manifest+json" } },
    { "src": "/dash/?", "dest": "/dash/index.html", "headers": { "X-Robots-Tag": "noindex, nofollow", "Cache-Control": "no-store" } },
    { "src": "/dash/tv/?", "dest": "/dash/index.html", "headers": { "X-Robots-Tag": "noindex, nofollow", "Cache-Control": "no-store" } },
    { "src": "/tvs/?", "dest": "/tvs/index.html", "headers": { "X-Robots-Tag": "noindex, nofollow", "Cache-Control": "no-store" } },
    { "src": "/tvs/player.js", "dest": "/tvs/player.js", "headers": { "Cache-Control": "no-cache", "Access-Control-Allow-Origin": "*" } },
    { "src": "/tv/?", "dest": "/tv/index.html", "headers": { "X-Robots-Tag": "noindex, nofollow", "Cache-Control": "no-store" } },
    { "src": "/black2026/?", "dest": "/black2026/index.html" },
    { "src": "/black2026/obrigado/?", "dest": "/black2026/obrigado/index.html", "headers": { "X-Robots-Tag": "noindex, nofollow" } },
    { "src": "/carta/img/(.*)", "dest": "/carta/img/$1" },
    { "src": "/carta(.*)", "status": 301, "headers": { "Location": "/baz$1" } },
    { "src": "/baz/img/(.*)", "dest": "/carta/img/$1" },
    { "src": "/baz/?", "dest": "/baz/index.html" },
    { "src": "/docismavalerio/?", "dest": "/docismavalerio/index.html" },
    { "src": "/girassol/?", "dest": "/girassol/index.html" },
    { "src": "/ncm-obrigado/?", "dest": "/ncm-obrigado/index.html" },
    { "src": "/but-obrigado/?", "dest": "/but-obrigado/index.html" },
    { "src": "/mbp-lp1/?", "dest": "/mbp-lp1/index.html" },
    { "src": "/mbp-obrigado/?", "dest": "/mbp-obrigado/index.html" },
    { "src": "/pesquisaalunos/img/(.*)", "dest": "/pesquisaalunos/img/$1" },
    { "src": "/pesquisaalunos/?", "dest": "/pesquisaalunos/index.html" },
    { "src": "/canaga/?", "dest": "/canaga/index.html" },
    { "src": "/daz/?", "dest": "/daz/index.html" },
    { "src": "/daz2/?", "dest": "/daz/index.html" },
    { "src": "/leadscanaga/?", "dest": "/leadscanaga/index.html", "headers": { "X-Robots-Tag": "noindex, nofollow", "Cache-Control": "no-store" } }
  ]
}
